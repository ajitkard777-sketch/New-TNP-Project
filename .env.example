# TPMS Environment Configuration

APP_ENV=development
APP_NAME=TPMS
APP_FULL_NAME="Training & Placement Management System"
BASE_URL=/TNP

# Database Configuration
DB_HOST=localhost
DB_NAME=team1
DB_USER=root
DB_PASS=

# =====================================================
# SMTP Mailer Configuration — Brevo SMTP
# Provider: https://app.brevo.com
# =====================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_account_email@example.com
SMTP_PASSWORD=your_brevo_smtp_key_here
SMTP_FROM_EMAIL=your_brevo_account_email@example.com
SMTP_FROM_NAME="TPMS System"

# SMTP Retry Configuration
SMTP_RETRY_ATTEMPTS=2
SMTP_RETRY_DELAY_MS=1200

# =====================================================
# How to get Brevo SMTP credentials:
# 1. Sign up at https://app.brevo.com (free: 300 emails/day)
# 2. Go to SMTP & API -> SMTP -> Generate a new SMTP key
# 3. Use your Brevo account email as SMTP_USERNAME
# 4. Use the generated SMTP key as SMTP_PASSWORD
# 5. Brevo SMTP Host: smtp-relay.brevo.com, Port: 587
# =====================================================

# AI Configuration (Groq / Gemini)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
